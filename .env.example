# P2.4 Commerce — local/dev (memory store for CI; use real Supabase in staging)

# Commerce store: memory | supabase
COMMERCE_STORE=memory

# Payment: mock | toss_test | live (live is blocked in P2.4)
PAYMENT_MODE=mock

# Supabase (required when COMMERCE_STORE=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Toss Payments TEST (required when PAYMENT_MODE=toss_test)
TOSS_CLIENT_KEY_TEST=
TOSS_SECRET_KEY_TEST=
NEXT_PUBLIC_TOSS_CLIENT_KEY_TEST=
NEXT_PUBLIC_PAYMENT_MODE=mock

# Legacy P2.3 localStorage mock purchase (dev review only)
ENABLE_LEGACY_MOCK_PURCHASE=false
