# P2.4 Commerce — local/dev (memory store for CI; use real Supabase in staging)

# Commerce store: memory | supabase
COMMERCE_STORE=memory

# Payment: mock | toss_test | live. Keep mock/test until live keys and the production E2E check pass.
PAYMENT_MODE=mock

# Supabase (required when COMMERCE_STORE=supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Toss Payments TEST (required when PAYMENT_MODE=toss_test)
TOSS_CLIENT_KEY_TEST=
TOSS_SECRET_KEY_TEST=
NEXT_PUBLIC_TOSS_CLIENT_KEY_TEST=
NEXT_PUBLIC_PAYMENT_MODE=mock

# Toss Payments LIVE (required when PAYMENT_MODE=live). The secret is server-only.
TOSS_CLIENT_KEY_LIVE=
TOSS_SECRET_KEY_LIVE=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# In the Toss Payments dashboard, register:
# https://YOUR_DOMAIN/api/payments/toss/webhook (PAYMENT_STATUS_CHANGED)

# Legacy P2.3 localStorage mock purchase (dev review only)
ENABLE_LEGACY_MOCK_PURCHASE=false

# P3.1 — 실제 배포 도메인(OG/공유 미리보기 이미지 URL 해석에 사용, 없으면 localhost로 대체)
NEXT_PUBLIC_SITE_URL=

# P3.2 Guest Recovery — 서버 전용 시크릿. 절대 커밋/로그/클라이언트 노출 금지.
# RECOVERY_CODE_SECRET: 결과 보관 코드 HMAC-SHA256 해시용
# RATE_LIMIT_IP_SECRET: Recovery API 레이트리밋 IP HMAC용(RECOVERY_CODE_SECRET과 별도 값 사용)
RECOVERY_CODE_SECRET=
RATE_LIMIT_IP_SECRET=
# 실제 배포 환경에서 x-forwarded-for를 신뢰할 수 있는 프록시가 확실히 덮어쓴다고 확인된
# 뒤에만 true로 켤 것 — 기본값 false(위조 가능한 헤더를 보안 판단에 쓰지 않음).
TRUST_PROXY_IP_HEADER=false

# P3.3 Admin (환불 신청 검토) — 서버 전용. ADMIN_PASSWORD는 관리자 로그인 비밀번호,
# ADMIN_SESSION_SECRET은 로그인 세션 쿠키 서명용 HMAC 시크릿(RECOVERY_CODE_SECRET과 별도 값 사용).
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
